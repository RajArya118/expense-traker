# Environment Variables Template for ExpenseFlow
# Duplicate this file to .env and replace placeholder values with your local or cloud credentials.
# NEVER commit .env to version control!

# ==============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ==============================================================================
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Examples:
# - Local Docker / Native Postgres: postgresql://postgres:postgres@localhost:5432/expenseflow?schema=public
# - Neon Serverless Postgres: postgresql://[user]:[password]@[endpoint].neon.tech/expenseflow?sslmode=require
# - Supabase: postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres?schema=public
DATABASE_URL="postgresql://postgres:REPLACE_WITH_SECURE_PASSWORD@localhost:5432/expenseflow?schema=public"

# Optional direct connection for migrations (required for pooled connections like Supabase Transaction pooler or PgBouncer)
DIRECT_URL="postgresql://postgres:REPLACE_WITH_SECURE_PASSWORD@localhost:5432/expenseflow?schema=public"

# ==============================================================================
# AUTHENTICATION & SECURITY
# ==============================================================================
# Generate a secret via: `openssl rand -base64 32`
NEXTAUTH_SECRET="your-generated-nextauth-secret-key-32-chars-min"
NEXTAUTH_URL="http://localhost:3000"

# ==============================================================================
# APPLICATION SETTINGS
# ==============================================================================
NEXT_PUBLIC_APP_NAME="ExpenseFlow"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_CURRENCY="USD"
